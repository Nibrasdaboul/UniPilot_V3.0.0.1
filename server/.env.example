# UniPilot Server Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=10000
NODE_ENV=development

# Database (Required)
# Local: postgresql://user:password@localhost:5432/unipilot
# Render: Automatically set from Render PostgreSQL database
DATABASE_URL=postgresql://user:password@localhost:5432/unipilot

# JWT Secret (Required)
# Must be 32+ characters, use a strong random string
# Example: UnipilotSuperStrongSecretKey2026!@#$%
JWT_SECRET=your-secret-key-change-in-production-32-chars-minimum

# Frontend URLs (Required for CORS)
FRONTEND_ORIGIN=http://localhost:5173
VITE_BACKEND_URL=http://localhost:10000
APP_URL=http://localhost:10000

# Optional: Stripe Payment Integration
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRO_PLAN_PRICE_ID=price_...
# STRIPE_STUDENT_PLAN_PRICE_ID=price_...

# Optional: Groq AI Integration
# GROQ_API_KEY=gsk_...

# Optional: Sentry Error Tracking
# SENTRY_DSN=https://...

# Optional: PostHog Analytics
# POSTHOG_API_KEY=phc_...

# Optional: Redis Caching
# REDIS_URL=redis://localhost:6379

# Optional: Logging
# LOG_LEVEL=info
